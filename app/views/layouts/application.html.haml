!!!
%html
  %head
    %meta(charset="utf-8")
    %meta(http-equiv="X-UA-Compatible" content="IE=Edge,chrome=1")
    %meta(name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no")
    :plain
      <!-- Global site tag (gtag.js) - Google Analytics -->
      <script async src="https://www.googletagmanager.com/gtag/js?id=UA-6896924-8"></script>
      <script>
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        gtag('js', new Date());

        gtag('config', 'UA-6896924-8');
      </script>
    %title autosome.org Opera House: bioinformatics tools on the web
    = stylesheet_link_tag 'application', media: 'all'
    = stylesheet_link_tag 'asset_urls', media: 'all'
    = javascript_include_tag 'application', defer: true
    = csrf_meta_tags
    = favicon_link_tag 'favicon.ico'
  %body{data: {controller: params[:controller], action: params[:action]}}
    %header
      %nav.navbar.navbar-expand-lg.bg-body-tertiary.shadow-sm.border-bottom.border-secondary-subtle
        .container-fluid
          = link_to root_path, class: "navbar-brand autosome_logo" do
            = image_tag "autosome_logo.png", alt: "autosome.org"

          %button.navbar-toggler{type: "button", "data-bs-toggle" => "collapse", "data-bs-target" => "#mainNavbar", "aria-controls" => "mainNavbar", "aria-expanded" => "false", "aria-label" => "Toggle navigation"}
            %span.navbar-toggler-icon

          #mainNavbar.collapse.navbar-collapse
            %ul.navbar-nav.me-auto.mb-2.mb-lg-0
              %li.nav-item.dropdown
                %a.nav-link.dropdown-toggle{href: "#", role: "button", "data-bs-toggle" => "dropdown", "aria-expanded" => "false"}
                  MACRO-APE
                %ul.dropdown-menu
                  %li= link_to "Compare two motifs", new_macroape_compare_path, class: "dropdown-item"
                  %li= link_to "Find similar motif", new_macroape_scan_path, class: "dropdown-item"
                  %li= link_to "Description", macroape_description_path, class: "dropdown-item"

              %li.nav-item.dropdown
                %a.nav-link.dropdown-toggle{href: "#", role: "button", "data-bs-toggle" => "dropdown", "aria-expanded" => "false"}
                  PERFECTOS-APE
                %ul.dropdown-menu
                  %li= link_to "rSNP TFBS annotation", new_perfectosape_scan_path, class: "dropdown-item"
                  %li= link_to "Description", perfectosape_description_path, class: "dropdown-item"

              %li.nav-item.dropdown
                %a.nav-link.dropdown-toggle{href: "#", role: "button", "data-bs-toggle" => "dropdown", "aria-expanded" => "false"}
                  ChIPMunk
                %ul.dropdown-menu
                  %li= link_to "Motif discovery", new_chipmunk_discovery_mono_path, class: "dropdown-item"
                  %li= link_to "Dinucleotide motif discovery", new_chipmunk_discovery_di_path, class: "dropdown-item"
                  %li= link_to "Description", chipmunk_description_path, class: "dropdown-item"

              %li.nav-item.dropdown
                %a.nav-link.dropdown-toggle{href: "#", role: "button", "data-bs-toggle" => "dropdown", "aria-expanded" => "false"}
                  Databases
                %ul.dropdown-menu
                  %li= link_to "HOCOMOCO – collection of TFBS motifs", "https://hocomoco.autosome.org/", class: "dropdown-item"
                  %li= link_to "EpiFactors – database for epigenetic regulators", "https://epifactors.autosome.org/", class: "dropdown-item"
                  %li= link_to "ADASTRA – database of allele-specific TF binding sites", "https://adastra.autosome.org/", class: "dropdown-item"

              %li.nav-item
                = link_to "Contacts", contacts_path, class: "nav-link"

            = form_tag search_tasks_path, class: "d-flex", role: "search" do
              = text_field_tag "id", nil, class: "form-control me-2", placeholder: "Ticket number"
              = submit_tag "Search", class: "btn btn-outline-secondary"
    .container-fluid
      = yield
      .footer
        .grant Supported by RFBR grants 15-34-20423 and 16-34-01318.
    %footer
