!!!
%html
  %head
    %meta(charset="utf-8")
    %meta(http-equiv="X-UA-Compatible" content="IE=Edge,chrome=1")
    %meta(name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no")
    :plain
      <!-- Global site tag (gtag.js) - Google Analytics -->
      <script async src="https://www.googletagmanager.com/gtag/js?id=UA-6896924-8"></script>
      <script>
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        gtag('js', new Date());

        gtag('config', 'UA-6896924-8');
      </script>
    %title autosome.org Opera House: bioinformatics tools on the web
    = stylesheet_link_tag 'application', media: 'all' # sprockets
    = stylesheet_pack_tag 'application', media: 'all' # webpack
    = javascript_pack_tag 'application', defer: true  # webpack
    = javascript_include_tag 'application', defer: true # sprockets (after webpack)
    = csrf_meta_tags
    = favicon_link_tag 'favicon.ico'
  %body{data: {controller: params[:controller], action: params[:action]}}
    %header
      %nav.navbar
        .navbar-inner
          .container-fluid
            / Кнопка для collapse (как в Bootstrap 2 responsive navbar)
            %a.btn.btn-navbar{"data-toggle" => "collapse", "data-target" => ".nav-collapse"}
              %span.icon-bar
              %span.icon-bar
              %span.icon-bar

            / Brand / logo
            %ul.nav
              = link_to root_path, class: "autosome_logo" do
                = image_tag "autosome_logo.png", alt: "autosome.org"

            .nav-collapse.collapse
              %ul.nav
                / MACRO-APE
                %li.dropdown
                  %a.dropdown-toggle{href: "javascript:void(0)", "data-toggle" => "dropdown"}
                    MACRO-APE
                    %b.caret
                  %ul.dropdown-menu
                    %li= link_to "Compare two motifs", new_macroape_compare_path
                    %li= link_to "Find similar motif", new_macroape_scan_path
                    %li= link_to "Description", macroape_description_path

                / PERFECTOS-APE
                %li.dropdown
                  %a.dropdown-toggle{href: "javascript:void(0)", "data-toggle" => "dropdown"}
                    PERFECTOS-APE
                    %b.caret
                  %ul.dropdown-menu
                    %li= link_to "rSNP TFBS annotation", new_perfectosape_scan_path
                    %li= link_to "Description", perfectosape_description_path

                / ChIPMunk
                %li.dropdown
                  %a.dropdown-toggle{href: "javascript:void(0)", "data-toggle" => "dropdown"}
                    ChIPMunk
                    %b.caret
                  %ul.dropdown-menu
                    %li= link_to "Motif discovery", new_chipmunk_discovery_mono_path
                    %li= link_to "Dinucleotide motif discovery", new_chipmunk_discovery_di_path
                    %li= link_to "Description", chipmunk_description_path

                / Databases
                %li.dropdown
                  %a.dropdown-toggle{href: "javascript:void(0)", "data-toggle" => "dropdown"}
                    Databases
                    %b.caret
                  %ul.dropdown-menu
                    %li= link_to "HOCOMOCO – collection of TFBS motifs", "https://hocomoco.autosome.org/"
                    %li= link_to "EpiFactors – database for epigenetic regulators", "https://epifactors.autosome.org/"
                    %li= link_to "ADASTRA – database of allele-specific TF binding sites", "https://adastra.autosome.org/"

                %li= link_to "Contacts", contacts_path

              = form_tag search_tasks_path, class: "navbar-search pull-right" do
                = label_tag nil do
                  Ticket number:
                  = text_field_tag "id"
                = submit_tag "Search" #, class: "btn"
    .container-fluid
      = yield
      .footer
        .grant Supported by RFBR grants 15-34-20423 and 16-34-01318.
    %footer
