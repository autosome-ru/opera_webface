.result_data
  .row
    .col-12
      %b= download_link 'Results (download complete tsv table)', ticket, 'task_result.txt'
      = snp_scan_table(task_results, task_params)
.input_data
  .row
    .col-12
      %h5.collection_name
        Collection:
        %em= I18n.t "enumerize.collection.#{task_params.collection}"
  .row
    .col-12
      .snp_list
        .my-label
          SNP list
          = download_list ticket, {'txt' => 'snp_list.txt'}
        %pre= (task_params.snp_list.lines.size <= 5) ? task_params.snp_list : task_params.snp_list.lines.first(5).join("\n") + "\n...\n"
  .row.mt-3.mb-3
    .col-3
      = download_link t('task_layout.task_details'), ticket, 'task_params.yaml'
